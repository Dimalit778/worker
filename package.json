{
  "name": "court-guard-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "ci": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test:run && pnpm build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:force-reset": "prisma db push --force-reset",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "db:seed:employees": "tsx --env-file=.env.local prisma/seed-employees.ts",
    "db:seed:demo-bat-yam": "tsx --env-file=.env.local prisma/demo-two-schedule-bat-yam.ts",
    "db:studio": "prisma studio",
    "test:integration": "vitest run tests/scheduling-postgres.test.ts",
    "db:check-rls": "tsx scripts/check-rls.ts",
    "db:seed:district-facilities": "tsx prisma/seed-district-facilities.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-auth": "^4.24.13",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@prisma/adapter-pg": "7.8.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "prisma": "^7.8.0",
    "prisma-erd-generator": "^3.2.1",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^6.3.0",
    "vitest": "^4.1.4"
  }
}
