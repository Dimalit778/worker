generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum ScheduleChangeType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  MANUAL_OVERRIDE
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum DayCategory {
  WEEKDAY
  FRIDAY
  SATURDAY
  HOLIDAY
}

enum ScheduleStatus {
  DRAFT
  OPEN
  LOCKED
  PUBLISHED
  ARCHIVED
}

enum WarningType {
  UNDERSTAFFED
  UNFILLED
  MIN_NOT_MET
  CONFLICT
  FAIRNESS
}

enum WarningSeverity {
  ERROR
  WARNING
  INFO
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  systemRole         SystemRole @default(EMPLOYEE)
  mustChangePassword Boolean    @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedulesCreated WorkSchedule[]      @relation("ScheduleCreatedBy")
  scheduleChanges   ScheduleChangeLog[] @relation("ScheduleChangedBy")

  receivedPermissions UserPermission[] @relation("ReceivedPermissions")
  grantedPermissions  UserPermission[] @relation("GrantedPermissions")

  accounts Account[]
  sessions Session[]

  @@index([systemRole])
}

model UserPermission {
  id            String    @id @default(cuid())
  userId        String
  permissionKey String
  granted       Boolean   @default(true)
  grantedById   String
  note          String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User @relation("ReceivedPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("GrantedPermissions", fields: [grantedById], references: [id])

  @@unique([userId, permissionKey])
  @@index([userId])
  @@index([grantedById])
}

model Region {
  id   String @id @default(cuid())
  name String
  code String @unique

  courts Court[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Court {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  regionId String

  region Region @relation(fields: [regionId], references: [id])

  employees            Employee[]
  positions            Position[]
  shiftCapacities      ShiftCapacity[]
  schedules            WorkSchedule[]
  shiftAssignments     ShiftAssignment[]
  warnings             ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

model Employee {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  displayName String
  phone       String?
  positionId  String
  courtId     String
  isActive    Boolean @default(true)
  isReligious Boolean @default(false)

  court    Court    @relation(fields: [courtId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  user            User?
  availabilityForms AvailabilityForm[]
  assignments     ShiftAssignment[]
  fairnessRecords FairnessRecord[]
  warnings        ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtId])
  @@index([positionId])
}

model Position {
  id           String  @id @default(cuid())
  courtId      String
  name         String
  code         Int
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  color        String?

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  employees            Employee[]
  shiftCapacities      ShiftCapacity[]
  shiftAssignments     ShiftAssignment[]
  warnings             ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, name])
  @@unique([courtId, code])
  @@index([courtId])
  @@index([courtId, displayOrder])
}

model ShiftCapacity {
  id            String      @id @default(cuid())
  courtId       String
  positionId    String
  shiftType     ShiftType
  dayCategory   DayCategory
  requiredCount Int         @default(1)
  isActive      Boolean     @default(true)
  displayOrder  Int         @default(0)

  court    Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, positionId, shiftType, dayCategory])
  @@index([courtId, shiftType, dayCategory])
  @@index([positionId])
  @@index([courtId, displayOrder])
}

// ─── Availability / Employee Requests ────────────────────────────────────────

model AvailabilityForm {
  id          String    @id @default(cuid())
  scheduleId String
  employeeId String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  note String?

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shifts AvailabilityShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, employeeId])
  @@index([employeeId])
  @@index([scheduleId])
}

model AvailabilityShift {
  id        String   @id @default(cuid())
  formId    String
  date      DateTime @db.Date
  shiftType ShiftType

  form AvailabilityForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, date, shiftType])
  @@index([date, shiftType])
}

// ─── Work Schedule ───────────────────────────────────────────────────────────

model WorkSchedule {
  id                 String         @id @default(cuid())
  courtId             String
  name                String
  status              ScheduleStatus @default(DRAFT)
  generatedAt         DateTime       @default(now())
  publishedAt         DateTime?
  createdById         String
  submissionDeadline  DateTime
  startDate           DateTime       @db.Date
  endDate             DateTime       @db.Date

  court     Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ScheduleCreatedBy", fields: [createdById], references: [id])

  assignments       ShiftAssignment[]
  availabilityForms AvailabilityForm[]
  warnings          ScheduleWarning[]
  changeLogs        ScheduleChangeLog[]
  fairnessRecords   FairnessRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdById])
}

model ShiftAssignment {
  id               String    @id @default(cuid())
  scheduleId       String
  employeeId       String
  courtId          String
  positionId       String
  date             DateTime  @db.Date
  shiftType        ShiftType

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  court    Court        @relation(fields: [courtId], references: [id], onDelete: Cascade)
  position Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)

  changeLogs ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, employeeId, date, shiftType])

  @@index([scheduleId, date])
  @@index([scheduleId, date, shiftType, positionId])
  @@index([employeeId, date])
  @@index([courtId, date])
  @@index([positionId])
  @@index([shiftType])
}

model ScheduleWarning {
  id         String          @id @default(cuid())
  scheduleId String
  type       WarningType
  severity   WarningSeverity
  employeeId String?
  courtId    String?
  positionId String?
  shiftType  ShiftType?
  date       DateTime?       @db.Date
  message    String

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee?    @relation(fields: [employeeId], references: [id])
  court    Court?       @relation(fields: [courtId], references: [id])
  position Position?    @relation(fields: [positionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId, date])
  @@index([employeeId, date])
  @@index([courtId, date])
  @@index([positionId, date])
  @@index([shiftType])
}

model FairnessRecord {
  id            String @id @default(cuid())
  employeeId    String
  scheduleId    String
  totalShifts   Int    @default(0)
  morningShifts Int    @default(0)
  eveningShifts Int    @default(0)
  nightShifts   Int    @default(0)
  weekendShifts Int    @default(0)
  totalHours    Int    @default(0)

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, scheduleId])
  @@index([scheduleId])
}

model ScheduleChangeLog {
  id                String             @id @default(cuid())
  scheduleId        String
  shiftAssignmentId String?
  changedById       String
  changeType        ScheduleChangeType
  message           String?
  reason            String?
  beforeData        Json?
  afterData         Json?
  createdAt         DateTime           @default(now())

  schedule        WorkSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  changedBy       User             @relation("ScheduleChangedBy", fields: [changedById], references: [id])

  @@index([scheduleId, createdAt])
  @@index([shiftAssignmentId])
  @@index([changedById, createdAt])
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}