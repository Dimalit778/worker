generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum ScheduleChangeType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  MANUAL_OVERRIDE
}

enum Position {
  GUARD
  BAKAR
  SHIFT_MANAGER
  FACILITY_OFFICER
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum DayCategory {
  WEEKDAY
  FRIDAY
  SATURDAY
  HOLIDAY
}

enum PeriodStatus {
  DRAFT
  OPEN_FOR_SUBMISSION
  LOCKED
  ARCHIVED
}

enum ScheduleStatus {
  DRAFT
  FINALIZED
  PUBLISHED
}

enum WarningType {
  UNDERSTAFFED
  UNFILLED
  MIN_NOT_MET
  CONFLICT
  FAIRNESS
}

enum WarningSeverity {
  ERROR
  WARNING
  INFO
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  systemRole         SystemRole @default(EMPLOYEE)
  mustChangePassword Boolean    @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodsCreated     SchedulePeriod[]    @relation("PeriodCreatedBy")
  schedulesGenerated Schedule[]          @relation("ScheduleGeneratedBy")
  scheduleChanges    ScheduleChangeLog[] @relation("ScheduleChangedBy")

  accounts Account[]
  sessions Session[]

  @@index([systemRole])
}

model Region {
  id   String @id @default(cuid())
  name String
  code String @unique

  courts Court[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Court {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  regionId String

  region Region @relation(fields: [regionId], references: [id])

  employees        Employee[]
  courtShiftRoles  CourtShiftRole[]
  periods          SchedulePeriod[]
  shiftAssignments ShiftAssignment[]
  warnings         ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

model Employee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  position  Position
  courtId   String
  isActive  Boolean  @default(true)

  court Court @relation(fields: [courtId], references: [id])

  user            User?
  availabilities  Availability[]
  assignments     ShiftAssignment[]
  fairnessRecords FairnessRecord[]
  warnings        ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtId])
  @@index([position])
}

// אילו roles קיימים בבית משפט ובאיזו משמרת
model CourtShiftRole {
  id           String    @id @default(cuid())
  courtId      String
  code         String
  name         String
  shiftType    ShiftType
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  staffingRules    CourtStaffRule[]
  assignments      ShiftAssignment[]
  allowedPositions CourtShiftRoleAllowedPosition[]
  warnings         ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, code, shiftType])
  @@index([courtId, shiftType, displayOrder])
}

// אילו Position-ים מותרים לכל CourtShiftRole
model CourtShiftRoleAllowedPosition {
  id               String   @id @default(cuid())
  courtShiftRoleId String
  position         Position

  courtShiftRole CourtShiftRole @relation(fields: [courtShiftRoleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([courtShiftRoleId, position])
  @@index([position])
}

// כמה צריך מכל role בכל סוג יום
model CourtStaffRule {
  id               String      @id @default(cuid())
  courtShiftRoleId String
  dayCategory      DayCategory
  requiredCount    Int
  displayOrder     Int

  courtShiftRole CourtShiftRole @relation(fields: [courtShiftRoleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayCategory, courtShiftRoleId])
  @@index([dayCategory, displayOrder])
  @@index([courtShiftRoleId])
}

model SchedulePeriod {
  id                 String       @id @default(cuid())
  courtId            String
  name               String
  startDate          DateTime     @db.Date
  endDate            DateTime     @db.Date
  submissionDeadline DateTime
  status             PeriodStatus @default(DRAFT)
  createdById        String

  court           Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("PeriodCreatedBy", fields: [createdById], references: [id])
  availabilities  Availability[]
  schedule        Schedule?
  fairnessRecords FairnessRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, startDate, endDate])
  @@index([courtId, status])
  @@index([startDate, endDate])
}

model Availability {
  id          String    @id @default(cuid())
  periodId    String
  employeeId  String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  period   SchedulePeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  AvailabilityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

model AvailabilityEntry {
  id             String    @id @default(cuid())
  availabilityId String
  date           DateTime  @db.Date
  shiftType      ShiftType
  isAvailable    Boolean   @default(false)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([availabilityId, date, shiftType])
  @@index([date, shiftType])
}

model Schedule {
  id            String         @id @default(cuid())
  periodId      String         @unique
  status        ScheduleStatus @default(DRAFT)
  generatedAt   DateTime       @default(now())
  publishedAt   DateTime?
  generatedById String

  period      SchedulePeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  generatedBy User                @relation("ScheduleGeneratedBy", fields: [generatedById], references: [id])
  assignments ShiftAssignment[]
  warnings    ScheduleWarning[]
  changeLogs  ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftAssignment {
  id               String   @id @default(cuid())
  scheduleId       String
  employeeId       String
  courtShiftRoleId String
  date             DateTime @db.Date
  slotIndex        Int
  isManualOverride Boolean  @default(false)
  courtId          String

  schedule       Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courtShiftRole CourtShiftRole @relation(fields: [courtShiftRoleId], references: [id], onDelete: Cascade)
  court          Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)

  changeLogs ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, employeeId, date, courtShiftRoleId, slotIndex])
  @@index([scheduleId, date])
  @@index([employeeId, date])
  @@index([courtShiftRoleId])
  @@index([courtId, date])
}

model ScheduleWarning {
  id               String          @id @default(cuid())
  scheduleId       String
  type             WarningType
  severity         WarningSeverity
  employeeId       String?
  courtId          String?
  courtShiftRoleId String?
  date             DateTime?       @db.Date
  message          String

  schedule       Schedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee       Employee?       @relation(fields: [employeeId], references: [id])
  court          Court?          @relation(fields: [courtId], references: [id])
  courtShiftRole CourtShiftRole? @relation(fields: [courtShiftRoleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId, date])
  @@index([employeeId, date])
  @@index([courtId, date])
  @@index([courtShiftRoleId, date])
}

model FairnessRecord {
  id            String @id @default(cuid())
  employeeId    String
  periodId      String
  totalShifts   Int    @default(0)
  morningShifts Int    @default(0)
  eveningShifts Int    @default(0)
  nightShifts   Int    @default(0)
  weekendShifts Int    @default(0)

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   SchedulePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodId])
  @@index([periodId])
}

model ScheduleChangeLog {
  id                String             @id @default(cuid())
  scheduleId        String
  shiftAssignmentId String?
  changedById       String
  changeType        ScheduleChangeType
  message           String?
  reason            String?
  beforeData        Json?
  afterData         Json?
  createdAt         DateTime           @default(now())

  schedule        Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  changedBy       User             @relation("ScheduleChangedBy", fields: [changedById], references: [id])

  @@index([scheduleId, createdAt])
  @@index([shiftAssignmentId])
  @@index([changedById, createdAt])
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
