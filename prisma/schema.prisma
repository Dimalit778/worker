generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  ADMIN
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum DayCategory {
  WEEKDAY
  FRIDAY
  SATURDAY
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AvailabilityPreference {
  AVAILABLE
  PREFERRED
  UNAVAILABLE
}

enum AssignmentSource {
  MANUAL
  AUTOMATIC
}

enum EmployeeRequestType {
  TIME_OFF
  SHIFT_SWAP
  URGENT_ABSENCE
}

enum EmployeeRequestStatus {
  PENDING_PEER
  PENDING_MANAGER
  APPROVED
  REJECTED
  CANCELLED
}

enum ScheduleChangeType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  ARCHIVE
  MANUAL_OVERRIDE
}

// Authentication models retained from the existing schema.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// עובד במתקן אחד. דירוג נגזר מהתפקיד ואינו נשמר בשדה נוסף.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  systemRole   SystemRole @default(USER)
  firstName    String
  lastName     String
  displayName  String
  phoneNumber  String?
  isReligious  Boolean    @default(false)
  facilityId   String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  canEditSchedule Boolean @default(false)

  /// עובד מושבת אינו יכול להתחבר או להשתבץ; ההיסטוריה נשמרת.
  isActive         Boolean   @default(true)
  deactivatedAt    DateTime? @db.Timestamptz(3)
  /// הוסר מניהול העובדים; הזהות והשיבוצים הקיימים נשמרים.
  deletedAt        DateTime? @db.Timestamptz(3)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(3)

  facility    Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  slots       ScheduleSlot[]
  submissions AvailabilitySubmission[]
  changes     ScheduleChange[]
  accounts    Account[]
  sessions    Session[]

  staffingOverrides StaffingDateOverride[]
  requests          EmployeeRequest[]      @relation("RequestRequester")
  incomingRequests  EmployeeRequest[]      @relation("RequestTarget")
  decidedRequests   EmployeeRequest[]      @relation("RequestDecider")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, facilityId])
  @@index([facilityId])
  @@index([systemRole])
  @@index([roleId])
}

/// תפקיד משותף: קצין=1, אחמש=2, בקר=3, מאבטח=4. מספר קטן יותר מציין דרגה גבוהה יותר.
model Role {
  id   String @id @default(cuid())
  code String @unique
  name String
  rank Int    @unique

  users        User[]
  basePosition Position?
}

model District {
  id   String @id @default(cuid())
  name String
  code String @unique

  facilities Facility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Facility {
  id         String @id @default(cuid())
  name       String
  code       String @unique
  districtId String

  district District        @relation(fields: [districtId], references: [id], onDelete: Restrict)
  users    User[]
  shifts   FacilityShift[]

  positions            Position[]
  staffingRequirements StaffingRequirement[]
  staffingOverrides    StaffingDateOverride[]
  schedules            Schedule[]
  requests             EmployeeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

model FacilityShift {
  id           String    @id @default(cuid())
  facilityId   String
  shiftType    ShiftType
  startTime    String // HH:mm in Facility.timeZone
  endTime      String // HH:mm in Facility.timeZone
  endDayOffset Int       @default(0) // 1 for NIGHT; 0 otherwise

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, shiftType])
}

/// ארבע עמדות בסיס משותפות לכל המתקנים; עמדות נוספות שייכות למתקן אחד.
/// Base positions cannot be removed; deactivate custom positions instead of deleting history.
model Position {
  id         String  @id @default(cuid())
  facilityId String?
  name       String
  baseRoleId String? @unique // null for custom positions such as parking
  baseRole   Role?   @relation(fields: [baseRoleId], references: [id], onDelete: Restrict)

  // Global: facilityId=null, baseRoleId set. Custom: facilityId set, baseRoleId=null.
  // Enforce this shape in SQL/application validation.
  requiredRank Int?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  color        String?

  facility     Facility?              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  requirements StaffingRequirement[]
  overrides    StaffingDateOverride[]
  slots        ScheduleSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId, isActive, displayOrder])
}

/// תבנית מספר המקומות הדרושים; מועתקת למקומות בעת יצירת סידור.
model StaffingRequirement {
  id            String      @id @default(cuid())
  facilityId    String
  positionId    String
  shiftType     ShiftType
  dayCategory   DayCategory
  requiredCount Int         @default(0)

  // Position must be global or belong to this facility; validate on writes.
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  position Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([facilityId, positionId, shiftType, dayCategory])
  @@index([positionId])
}

/// תקן חריג לתאריך מסוים (חג/אירוע). מחליף את תקן סוג היום עבור אותו תאריך, משמרת ועמדה.
model StaffingDateOverride {
  id            String    @id @default(cuid())
  facilityId    String
  date          DateTime  @db.Date
  positionId    String
  shiftType     ShiftType
  requiredCount Int
  label         String?
  createdById   String

  facility  Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  position  Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, date, positionId, shiftType])
  @@index([facilityId, date])
  @@index([positionId])
}

model Schedule {
  id                 String            @id @default(cuid())
  facilityId         String
  name               String
  startDate          DateTime          @db.Date
  endDate            DateTime          @db.Date
  submissionOpensAt  DateTime          @db.Timestamptz(3)
  submissionClosesAt DateTime          @db.Timestamptz(3)
  status             ScheduleStatus    @default(DRAFT)
  publishedAt        DateTime?         @db.Timestamptz(3)
  openNotifiedAt     DateTime?         @db.Timestamptz(3)
  reminderSentAt     DateTime?         @db.Timestamptz(3)
  draftVersionId     String?           @unique
  originalVersionId  String?           @unique
  originalVersion    ScheduleVersion?  @relation("OriginalVersion", fields: [originalVersionId, id, facilityId], references: [id, scheduleId, facilityId], onDelete: Restrict)
  publishedVersionId String?           @unique
  draftVersion       ScheduleVersion?  @relation("DraftVersion", fields: [draftVersionId, id, facilityId], references: [id, scheduleId, facilityId], onDelete: Restrict)
  publishedVersion   ScheduleVersion?  @relation("PublishedVersion", fields: [publishedVersionId, id, facilityId], references: [id, scheduleId, facilityId], onDelete: Restrict)
  versions           ScheduleVersion[] @relation("ScheduleVersions")

  facility    Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  slots       ScheduleSlot[]
  submissions AvailabilitySubmission[]
  changes     ScheduleChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, facilityId])
  // Dates are unique per facility only for non-archived periods: a partial index in SQL (not representable here), like ScheduleVersion_one_draft.
  @@unique([originalVersionId, id, facilityId])
  @@unique([draftVersionId, id, facilityId])
  @@unique([publishedVersionId, id, facilityId])
}

/// The original snapshot is immutable; the current published version is edited in place.
model ScheduleVersion {
  id               String         @id @default(cuid())
  scheduleId       String
  facilityId       String
  number           Int
  revision         Int            @default(0)
  status           ScheduleStatus @default(DRAFT)
  publishedAt      DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now())
  capacitySnapshot Json?

  schedule     Schedule         @relation("ScheduleVersions", fields: [scheduleId, facilityId], references: [id, facilityId], onDelete: Restrict)
  draftFor     Schedule?        @relation("DraftVersion")
  publishedFor Schedule?        @relation("PublishedVersion")
  originalFor  Schedule?        @relation("OriginalVersion")
  slots        ScheduleSlot[]
  changes      ScheduleChange[]

  @@unique([id, scheduleId, facilityId])
  @@unique([scheduleId, number])
}

model ScheduleSlot {
  id         String           @id @default(cuid())
  facilityId String
  scheduleId String
  versionId  String
  positionId String
  date       DateTime         @db.Date
  shiftType  ShiftType
  slotNumber Int
  startsAt   DateTime         @db.Timestamptz(3)
  endsAt     DateTime         @db.Timestamptz(3)
  userId     String?
  source     AssignmentSource @default(MANUAL)
  isLocked   Boolean          @default(false)
  note       String?

  schedule Schedule          @relation(fields: [scheduleId, facilityId], references: [id, facilityId], onDelete: Restrict)
  version  ScheduleVersion   @relation(fields: [versionId, scheduleId, facilityId], references: [id, scheduleId, facilityId], onDelete: Restrict)
  // Position must be global or belong to facilityId; validate on writes.
  position Position          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user     User?             @relation(fields: [userId, facilityId], references: [id, facilityId], onDelete: Restrict)
  requests EmployeeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, date, shiftType, positionId, slotNumber])
  @@index([userId, startsAt])
  @@index([facilityId, date])
  @@index([positionId, facilityId])
}

/// הגשה אחת לעובד ולסידור. submittedAt ריק = טיוטה.
model AvailabilitySubmission {
  id           String    @id @default(cuid())
  facilityId   String
  scheduleId   String
  userId       String
  submittedAt  DateTime? @db.Timestamptz(3)
  note         String?
  /// שינויים שנשמרו ולא הוגשו; ShiftAvailability מכיל רק את מה שהוגש.
  draftEntries Json?
  draftNote    String?
  draftSavedAt DateTime? @db.Timestamptz(3)

  schedule       Schedule            @relation(fields: [scheduleId, facilityId], references: [id, facilityId], onDelete: Restrict)
  user           User                @relation(fields: [userId, facilityId], references: [id, facilityId], onDelete: Restrict)
  availabilities ShiftAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, userId])
  @@index([userId, facilityId])
}

/// זמינות לסוג משמרת בתאריך מסוים; העדר בחירה אינו נחשב זמינות.
model ShiftAvailability {
  id           String                 @id @default(cuid())
  submissionId String
  date         DateTime               @db.Date
  shiftType    ShiftType
  preference   AvailabilityPreference

  submission AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, date, shiftType])
}

/// היסטוריה שנכתבת באותה טרנזקציה עם השינוי. אין למחוק או לערוך אירועים.
model ScheduleChange {
  id          String             @id @default(cuid())
  facilityId  String
  scheduleId  String
  changedById String
  versionId   String?
  changeType  ScheduleChangeType
  reason      String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  schedule  Schedule         @relation(fields: [scheduleId, facilityId], references: [id, facilityId], onDelete: Restrict)
  version   ScheduleVersion? @relation(fields: [versionId, scheduleId, facilityId], references: [id, scheduleId, facilityId], onDelete: Restrict)
  changedBy User             @relation(fields: [changedById, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@index([scheduleId, createdAt])
  @@index([changedById, facilityId])
}

/// בקשת עובד: חופשה, העברת משמרת או היעדרות דחופה. עד אישור סופי האחריות נשארת אצל המבקש.
model EmployeeRequest {
  id              String                @id @default(cuid())
  facilityId      String
  type            EmployeeRequestType
  status          EmployeeRequestStatus
  requesterId     String
  startDate       DateTime?             @db.Date
  endDate         DateTime?             @db.Date
  /// העברת משמרת: מזהה משבצת יציב בשיבוץ הנוכחי; האיוש נבדק שוב באישור.
  slotId          String?
  targetUserId    String?
  reason          String?
  peerRespondedAt DateTime?             @db.Timestamptz(3)
  decidedById     String?
  decidedAt       DateTime?             @db.Timestamptz(3)
  decisionNote    String?
  overrideReason  String?

  facility  Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  requester User          @relation("RequestRequester", fields: [requesterId, facilityId], references: [id, facilityId], onDelete: Restrict)
  target    User?         @relation("RequestTarget", fields: [targetUserId, facilityId], references: [id, facilityId], onDelete: Restrict)
  decidedBy User?         @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  slot      ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilityId, status])
  @@index([requesterId, facilityId])
  @@index([targetUserId, facilityId])
  @@index([slotId])
}

/// הגדרות מערכת קיימות שאינן חלק ממבנה הסידור.
model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
