generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  EMPLOYEE
  MANAGER 
  ADMIN
}

enum Position {
  GUARD
  BAKAR
  SHIFT_MANAGER
  FACILITY_OFFICER
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum PeriodStatus {
DRAFT
OPEN_FOR_SUBMISSION
LOCKED
ARCHIVED
}

enum ScheduleStatus {
DRAFT
FINALIZED
PUBLISHED
}

enum WarningType {
  UNDERSTAFFED
  UNFILLED
  MIN_NOT_MET
  CONFLICT
  FAIRNESS
}

enum WarningSeverity {
  ERROR
  WARNING
  INFO
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────
model User {
  id                 String     @id @default(cuid())
  email              String?    @unique
  employeeNumber     String?    @unique
  passwordHash       String
  systemRole         SystemRole @default(EMPLOYEE)
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)

  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  periodsCreated     SchedulingPeriod[] @relation("PeriodCreatedBy")
  schedulesGenerated Schedule[]         @relation("ScheduleGeneratedBy")
  warningActions     ScheduleWarning[]  @relation("WarningCreatedBy")

  accounts Account[]
  sessions Session[]

  @@index([systemRole])
}

model Employee {
  id             String    @id @default(cuid())
  employeeCode   String?   @unique
  name           String
  phone          String?
  position       Position
  primaryCourtId String?
  isActive       Boolean   @default(true)

  primaryCourt Court? @relation("PrimaryCourtEmployees", fields: [primaryCourtId], references: [id])

  user              User?
  courtEligibility  CourtEligibility[]
  availability      Availability[]
  assignments       ShiftAssignment[]
  fairnessRecords   FairnessRecord[]
  warnings          ScheduleWarning[] @relation("WarningEmployee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([primaryCourtId])
}

model Court {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  districtId String
  isActive Boolean @default(true)

  district District @relation(fields: [districtId], references: [id])

  capacityRules       ShiftCapacityRule[]
  eligibility         CourtEligibility[]
  primaryEmployees    Employee[]          @relation("PrimaryCourtEmployees")
  availabilityEntries AvailabilityEntry[]
  assignments         ShiftAssignment[]
  warnings            ScheduleWarning[]   @relation("WarningCourt")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}
model District {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)

  courts    Court[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourtEligibility {
  id         String @id @default(cuid())
  employeeId String
  courtId    String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  court    Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, courtId])
  @@index([courtId])
}

model ShiftCapacityRule {
  id        String    @id @default(cuid())
  courtId   String
  shiftType ShiftType
  dayOfWeek Int?      // 0=Sunday ... 6=Saturday; null = all days
  minStaff  Int
  maxStaff  Int

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, shiftType, dayOfWeek])
  @@index([courtId, shiftType])
}

model SchedulingPeriod {
  id                 String       @id @default(cuid())
  name               String
  startDate          DateTime     @db.Date
  endDate            DateTime     @db.Date
  submissionDeadline DateTime
  status             PeriodStatus @default(DRAFT)
  createdById        String

  createdBy       User             @relation("PeriodCreatedBy", fields: [createdById], references: [id])
  availability    Availability[]
  schedules       Schedule[]
  fairnessRecords FairnessRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
  @@index([status])
}

model Availability {
  id          String    @id @default(cuid())
  periodId    String
  employeeId  String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  period   SchedulingPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries   AvailabilityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

model AvailabilityEntry {
  id             String    @id @default(cuid())
  availabilityId String
  date           DateTime  @db.Date
  courtId        String
  shiftType      ShiftType
  isAvailable    Boolean   @default(false)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  court        Court        @relation(fields: [courtId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([availabilityId, date, courtId, shiftType])
  @@index([courtId, date, shiftType])
}

model Schedule {
  id            String         @id @default(cuid())
  periodId      String
  status        ScheduleStatus @default(DRAFT)
  generatedAt   DateTime       @default(now())
  publishedAt   DateTime?
  generatedById String

  period      SchedulingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  generatedBy User             @relation("ScheduleGeneratedBy", fields: [generatedById], references: [id])
  assignments ShiftAssignment[]
  warnings    ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodId, status])
}

model ShiftAssignment {
  id               String    @id @default(cuid())
  scheduleId       String
  employeeId       String
  courtId          String
  date             DateTime  @db.Date
  shiftType        ShiftType
  isOpeningDuty    Boolean   @default(false)
  isManualOverride Boolean   @default(false)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  court    Court    @relation(fields: [courtId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, employeeId, date, shiftType])
  @@index([courtId, date, shiftType])
  @@index([employeeId, date])
  @@index([scheduleId, date])
}

model ScheduleWarning {
  id          String          @id @default(cuid())
  scheduleId  String
  type        WarningType
  severity    WarningSeverity
  courtId     String?
  employeeId  String?
  date        DateTime?       @db.Date
  message     String
  createdById String?

  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  court      Court?    @relation("WarningCourt", fields: [courtId], references: [id])
  employee   Employee? @relation("WarningEmployee", fields: [employeeId], references: [id])
  createdBy  User?     @relation("WarningCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId, date])
  @@index([courtId, date])
  @@index([employeeId, date])
}

model FairnessRecord {
  id            String @id @default(cuid())
  employeeId    String
  periodId      String
  totalShifts   Int    @default(0)
  morningShifts Int    @default(0)
  eveningShifts Int    @default(0)
  nightShifts   Int    @default(0)
  weekendShifts Int    @default(0)
  openingDuties Int    @default(0)

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   SchedulingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodId])
  @@index([periodId])
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}