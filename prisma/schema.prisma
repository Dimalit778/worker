generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum ScheduleChangeType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  MANUAL_OVERRIDE
}


enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum DayCategory {
  WEEKDAY
  FRIDAY
  SATURDAY
  HOLIDAY
}

enum PeriodStatus {
  DRAFT
  OPEN_FOR_SUBMISSION
  LOCKED
  ARCHIVED
}

enum ScheduleStatus {
  DRAFT
  FINALIZED
  PUBLISHED
}

enum WarningType {
  UNDERSTAFFED
  UNFILLED
  MIN_NOT_MET
  CONFLICT
  FAIRNESS
}

enum WarningSeverity {
  ERROR
  WARNING
  INFO
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  systemRole         SystemRole @default(EMPLOYEE)
  mustChangePassword Boolean    @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodsCreated     SchedulePeriod[]    @relation("PeriodCreatedBy")
  schedulesGenerated Schedule[]          @relation("ScheduleGeneratedBy")
  scheduleChanges    ScheduleChangeLog[] @relation("ScheduleChangedBy")

  accounts Account[]
  sessions Session[]

  @@index([systemRole])
}

model Region {
  id   String @id @default(cuid())
  name String
  code String @unique

  courts Court[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Court {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  regionId String

  region Region @relation(fields: [regionId], references: [id])

  employees        Employee[]
  positions        Position[]
  shiftCapacities  ShiftCapacity[]
  periods          SchedulePeriod[]
  shiftAssignments ShiftAssignment[]
  warnings         ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

model Employee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  displayName String
  phone     String?
  positionId String
  courtId   String
  isActive  Boolean  @default(true)
  isReligious Boolean @default(false)

  court Court @relation(fields: [courtId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  user            User?
  availabilities  Availability[]
  assignments     ShiftAssignment[]
  fairnessRecords FairnessRecord[]
  warnings        ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtId])
  @@index([positionId])
}
model Position {
  id       String  @id @default(cuid())
  courtId  String
  name     String
  code     Int
  isActive Boolean @default(true)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  employees        Employee[]
  shiftCapacities  ShiftCapacity[]
  shiftAssignments ShiftAssignment[]
  warnings         ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, name])
  @@unique([courtId, code])
  @@index([courtId])
}
model ShiftCapacity {
  id           String      @id @default(cuid())
  courtId      String
  positionId   String
  shiftType    ShiftType
  dayCategory  DayCategory
  amount       Int         @default(1)
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)

  court    Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, positionId, shiftType, dayCategory])
  @@index([courtId, shiftType, dayCategory])
  @@index([positionId])
  @@index([courtId, displayOrder])
}

model SchedulePeriod {
  id                 String       @id @default(cuid())
  courtId            String
  name               String
  startDate          DateTime     @db.Date
  endDate            DateTime     @db.Date
  submissionDeadline DateTime
  status             PeriodStatus @default(DRAFT)
  createdById        String

  court           Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("PeriodCreatedBy", fields: [createdById], references: [id])
  availabilities  Availability[]
  schedule        Schedule?
  fairnessRecords FairnessRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, startDate, endDate])
  @@index([courtId, status])
  @@index([startDate, endDate])
}

model Availability {
  id          String    @id @default(cuid())
  periodId    String
  employeeId  String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  period   SchedulePeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  AvailabilityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

model AvailabilityEntry {
  id             String    @id @default(cuid())
  availabilityId String
  date           DateTime  @db.Date
  shiftType      ShiftType
  isAvailable    Boolean   @default(false)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([availabilityId, date, shiftType])
  @@index([date, shiftType])
}

model Schedule {
  id            String         @id @default(cuid())
  periodId      String         @unique
  status        ScheduleStatus @default(DRAFT)
  generatedAt   DateTime       @default(now())
  publishedAt   DateTime?
  generatedById String

  period      SchedulePeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  generatedBy User                @relation("ScheduleGeneratedBy", fields: [generatedById], references: [id])
  assignments ShiftAssignment[]
  warnings    ScheduleWarning[]
  changeLogs  ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftAssignment {
  id               String    @id @default(cuid())
  scheduleId       String
  employeeId       String
  courtId          String
  positionId       String
  date             DateTime  @db.Date
  shiftType        ShiftType
  slotIndex        Int
  isManualOverride Boolean   @default(false)

  schedule Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  court    Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  changeLogs ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, date, shiftType, positionId, slotIndex])
  @@index([scheduleId, date])
  @@index([employeeId, date])
  @@index([courtId, date])
  @@index([positionId])
  @@index([shiftType])
}

model ScheduleWarning {
  id         String          @id @default(cuid())
  scheduleId String
  type       WarningType
  severity   WarningSeverity
  employeeId String?
  courtId    String?  
  positionId String?
  shiftType  ShiftType?
  date       DateTime?       @db.Date
  message    String

  schedule Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee?      @relation(fields: [employeeId], references: [id])
  court    Court?         @relation(fields: [courtId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId, date])
  @@index([employeeId, date])
  @@index([courtId, date])
  @@index([positionId, date])
  @@index([shiftType])
}
model FairnessRecord {
  id            String @id @default(cuid())
  employeeId    String
  periodId      String
  totalShifts   Int    @default(0)
  morningShifts Int    @default(0)
  eveningShifts Int    @default(0)
  nightShifts   Int    @default(0)
  weekendShifts Int    @default(0)

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   SchedulePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodId])
  @@index([periodId])
}

model ScheduleChangeLog {
  id                String             @id @default(cuid())
  scheduleId        String
  shiftAssignmentId String?
  changedById       String
  changeType        ScheduleChangeType
  message           String?
  reason            String?
  beforeData        Json?
  afterData         Json?
  createdAt         DateTime           @default(now())

  schedule        Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  changedBy       User             @relation("ScheduleChangedBy", fields: [changedById], references: [id])

  @@index([scheduleId, createdAt])
  @@index([shiftAssignmentId])
  @@index([changedById, createdAt])
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
