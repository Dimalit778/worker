generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ─── Enums ───────────────────────────────────────────────────────────────────

enum SystemRole {
  EMPLOYEE
  MANAGER
  ADMIN
}
enum ScheduleChangeType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  MANUAL_OVERRIDE
}

enum Position {
  GUARD
  BAKAR
  SHIFT_MANAGER
  FACILITY_OFFICER
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

enum DayCategory {
  WEEKDAY
  FRIDAY
  SATURDAY
  HOLIDAY
}

enum PeriodStatus {
  DRAFT
  OPEN_FOR_SUBMISSION
  LOCKED
  ARCHIVED
}

enum ScheduleStatus {
  DRAFT
  FINALIZED
  PUBLISHED
}

enum WarningType {
  UNDERSTAFFED
  UNFILLED
  MIN_NOT_MET
  CONFLICT
  FAIRNESS
}

enum WarningSeverity {
  ERROR
  WARNING
  INFO
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────
 //= משתמש 
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  systemRole         SystemRole @default(EMPLOYEE)
  mustChangePassword Boolean    @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodsCreated     SchedulingPeriod[] @relation("PeriodCreatedBy")
  schedulesGenerated Schedule[]         @relation("ScheduleGeneratedBy")
  scheduleChanges ScheduleChangeLog[] @relation("ScheduleChangedBy")

  accounts Account[]
  sessions Session[]

  @@index([systemRole])
}
// = מחוז 
model Region {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique

  courts Court[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// = בית משפט
model Court {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  regionId String

  region Region @relation(fields: [regionId], references: [id])

  employees Employee[]
  shiftRules CourtShiftRule[]
  periods    SchedulingPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

// = עובד
model Employee {
  id       String   @id @default(cuid())
  firstName     String
  lastName     String
  phone    String?
  position Position
  courtId  String
  isActive Boolean  @default(true)

  court Court @relation(fields: [courtId], references: [id])

  user            User?
  availabilities  Availability[]
  assignments     ShiftAssignment[]
  fairnessRecords FairnessRecord[]
  warnings        ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courtId])
  @@index([position])
}

// = חוק משמרות
model CourtShiftRule {
  id            String      @id @default(cuid())
  courtId       String
  shiftType     ShiftType
  dayCategory   DayCategory
  position      Position
  requiredCount Int
  displayOrder  Int

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, shiftType, dayCategory, position])
  @@index([courtId, shiftType, dayCategory, displayOrder])
}

// = תקופת תזמון
model SchedulingPeriod {
  id                 String       @id @default(cuid())
  courtId            String
  name               String
  startDate          DateTime     @db.Date
  endDate            DateTime     @db.Date
  submissionDeadline DateTime
  status             PeriodStatus @default(DRAFT)
  createdById        String

  court           Court             @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("PeriodCreatedBy", fields: [createdById], references: [id])
  availabilities  Availability[]
  schedule        Schedule?
  fairnessRecords FairnessRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courtId, startDate, endDate])
  @@index([courtId, status])
  @@index([startDate, endDate])
}

// = זמינות
model Availability {
  id          String    @id @default(cuid())
  periodId    String
  employeeId  String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  period   SchedulingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  entries  AvailabilityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
}

// = רשומת זמינות
model AvailabilityEntry {
  id             String    @id @default(cuid())
  availabilityId String
  date           DateTime  @db.Date
  shiftType      ShiftType
  isAvailable    Boolean   @default(false)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([availabilityId, date, shiftType])
  @@index([date, shiftType])
}
// = שיבוץ פעיל 
model Schedule {
  id            String         @id @default(cuid())
  periodId      String         @unique
  status        ScheduleStatus @default(DRAFT)
  generatedAt   DateTime       @default(now())
  publishedAt   DateTime?
  generatedById String

  period      SchedulingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  generatedBy User             @relation("ScheduleGeneratedBy", fields: [generatedById], references: [id])
  assignments ShiftAssignment[]
  warnings    ScheduleWarning[]
  changeLogs ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// = שיבוץ פעיל 
model ShiftAssignment {
  id               String    @id @default(cuid())
  scheduleId       String
  employeeId       String
  date             DateTime  @db.Date
  shiftType        ShiftType
  position         Position
  slotIndex        Int
  isOpeningDuty    Boolean   @default(false)
  isManualOverride Boolean   @default(false)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  changeLogs ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, employeeId, date, shiftType, position, slotIndex])
  @@index([scheduleId, date])
  @@index([employeeId, date])
}
// = אזהרות בשיבוץ 
model ScheduleWarning {
  id         String          @id @default(cuid())
  scheduleId String
  type       WarningType
  severity   WarningSeverity
  employeeId String?
  date       DateTime?       @db.Date
  message    String

  schedule Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId, date])
  @@index([employeeId, date])
}
// =  רשימת שיוון משמרות 
model FairnessRecord {
  id            String @id @default(cuid())
  employeeId    String
  periodId      String
  totalShifts   Int    @default(0)
  morningShifts Int    @default(0)
  eveningShifts Int    @default(0)
  nightShifts   Int    @default(0)
  weekendShifts Int    @default(0)
  openingDuties Int    @default(0)

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period   SchedulingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, periodId])
  @@index([periodId])
}
// =  שינויים בשיבוץ 
model ScheduleChangeLog {
  id                String             @id @default(cuid())
  scheduleId        String
  shiftAssignmentId String?
  changedById       String
  changeType        ScheduleChangeType
  message           String?
  reason            String?
  beforeData        Json?
  afterData         Json?
  createdAt         DateTime           @default(now())

  schedule        Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  changedBy User @relation("ScheduleChangedBy", fields: [changedById], references: [id])

  @@index([scheduleId, createdAt])
  @@index([shiftAssignmentId])
  @@index([changedById, createdAt])
}

model SystemConfig {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}