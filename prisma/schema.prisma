// זרימת הגשה: Employee -> AvailabilitySubmission -> ShiftAvailability
// זרימת שיבוץ: SchedulePeriod -> Roster -> RosterVersion -> ShiftAssignment
// שני המסלולים נפגשים ב-SchedulePeriod. ההגשה אינה מבטיחה איוש.
// Partial unique indexes and publication/audit protection require SQL migrations;
// Prisma schema validation alone does not install those database invariants.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Capability {
  GUARD
  CONTROLLER
  SHIFT_MANAGER
}

enum AvailabilityPreference {
  AVAILABLE
  PREFERRED
  UNAVAILABLE
}

enum SubmissionState {
  SCHEDULED
  OPEN
  CLOSED
}

enum AssignmentSource {
  MANUAL
  AUTOMATIC
}

// Global access only. Employee identity comes from User.employee;
// management rights come from UserFacilityRole for the selected facility.
enum SystemRole {
  USER
  ADMIN
}

// Facility management is separate from an employee's scheduling capability.
enum FacilityRole {
  MANAGER
}

enum ScheduleChangeType {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  MANUAL_OVERRIDE
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
}

// Status of one roster version. Submission state belongs to SchedulePeriod.
enum ScheduleVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DayCategory {
  WEEKDAY
  FRIDAY
  SATURDAY
}

enum HolidayKind {
  EVE
  HOLIDAY
  SPECIAL_DAY
}

enum WarningType {
  UNDERSTAFFED
  UNFILLED
  MIN_NOT_MET
  CONFLICT
  FAIRNESS
}

enum WarningSeverity {
  ERROR
  WARNING
  INFO
}

// ─── NextAuth models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────────────────

/// חשבון כניסה. שיוך לעובד והרשאות ניהול במתקן הם קשרים נפרדים.
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  systemRole         SystemRole @default(USER)
  mustChangePassword Boolean    @default(false)

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilityRoles UserFacilityRole[]

  schedulesCreated    Roster[]        @relation("ScheduleCreatedBy")
  scheduleChanges     ScheduleChangeLog[]   @relation("ScheduleChangedBy")
  scheduleVersions    RosterVersion[] @relation("ScheduleVersionCreatedBy")
  receivedPermissions UserPermission[]      @relation("ReceivedPermissions")
  grantedPermissions  UserPermission[]      @relation("GrantedPermissions")

  accounts Account[]
  sessions Session[]

  @@index([systemRole])
}

/// תפקיד הרשאה של משתמש במתקן; אינו כשירות לעבודה במשמרת.
model UserFacilityRole {
  userId     String
  facilityId String
  role       FacilityRole
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([userId, facilityId])
  @@index([facilityId])
}

/// חריג הרשאה אישי. נשמר לתמיכה במנגנון ההרשאות הקיים.
model UserPermission {
  id            String    @id @default(cuid())
  userId        String
  permissionKey String
  granted       Boolean   @default(true)
  grantedById   String
  note          String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User @relation("ReceivedPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("GrantedPermissions", fields: [grantedById], references: [id])

  @@unique([userId, permissionKey])
  @@index([userId])
  @@index([grantedById])
}

/// מחוז שמאגד מתקנים.
model District {
  id   String @id @default(cuid())
  name String
  code String @unique

  facilities Facility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// מתקן שבו עובדים, מגישים זמינות ומפרסמים סידורי עבודה.
model Facility {
  id         String @id @default(cuid())
  name       String
  code       String @unique
  districtId String

  district District @relation(fields: [districtId], references: [id])

  facilityRoles        UserFacilityRole[]
  employees            Employee[]
  shiftRoles           ShiftRole[]
  staffingRequirements StaffingRequirement[]
  schedulePeriods      SchedulePeriod[]
  schedules            Roster[]
  scheduleVersions     RosterVersion[]
  shiftAssignments     ShiftAssignment[]
  warnings             ScheduleWarning[]

  submissionOpenWeekday  Int?
  submissionOpenTime     String?
  submissionCloseWeekday Int?
  submissionCloseTime    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

/// עובד במתקן יחיד. capability מגדיר לאילו תפקידים במשמרת הוא כשיר.
model Employee {
  id                 String     @id @default(cuid())
  firstName          String
  lastName           String
  displayName        String
  phone              String?
  primaryShiftRoleId String
  facilityId         String
  isActive           Boolean    @default(true)
  isReligious        Boolean    @default(false)
  capability         Capability @default(GUARD)

  facility Facility @relation(fields: [facilityId], references: [id])

  // Personnel designation; capability controls eligibility for assignment.
  primaryShiftRole ShiftRole @relation("EmployeePrimaryShiftRole", fields: [primaryShiftRoleId, facilityId], references: [id, facilityId])

  user                    User?
  availabilitySubmissions AvailabilitySubmission[]
  assignments             ShiftAssignment[]
  employeeStats           EmployeeScheduleStats[]
  warnings                ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, facilityId])
  @@index([facilityId])
  @@index([facilityId, isActive])
  @@index([primaryShiftRoleId])
  @@index([primaryShiftRoleId, facilityId])
}

/// תפקיד במשמרת עם כשירות נדרשת; עשוי לשמש גם כתפקיד ראשי ברשומת עובד.
model ShiftRole {
  id                 String     @id @default(cuid())
  facilityId         String
  name               String
  code               Int
  displayOrder       Int        @default(0)
  isActive           Boolean    @default(true)
  color              String?
  requiredCapability Capability @default(GUARD)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  primaryEmployees     Employee[]            @relation("EmployeePrimaryShiftRole")
  staffingRequirements StaffingRequirement[]
  shiftAssignments     ShiftAssignment[]
  warnings             ScheduleWarning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, name])
  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@index([facilityId])
  @@index([facilityId, displayOrder])
}

/// מספר עובדים נדרש לפי מתקן, תפקיד, סוג משמרת וסוג יום.
model StaffingRequirement {
  id            String      @id @default(cuid())
  facilityId    String
  shiftRoleId   String
  shiftType     ShiftType
  dayCategory   DayCategory
  requiredCount Int         @default(1)
  isActive      Boolean     @default(true)
  displayOrder  Int         @default(0)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  shiftRole ShiftRole @relation(fields: [shiftRoleId, facilityId], references: [id, facilityId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facilityId, shiftRoleId, shiftType, dayCategory])
  @@index([facilityId, isActive])
  @@index([facilityId, shiftType, dayCategory])
  @@index([shiftRoleId])
  @@index([shiftRoleId, facilityId])
  @@index([facilityId, displayOrder])
}



// ─── Availability / Employee Requests ────────────────────────────────────────

/// הגשת זמינות אחת לעובד ולתקופה; isSubmitted מבדיל טיוטה מהגשה שנשלחה.
model AvailabilitySubmission {
  id          String    @id @default(cuid())
  periodId    String
  employeeId  String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?

  note String?

  period   SchedulePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shiftAvailabilities ShiftAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@index([periodId])
}

/// בחירת זמינות אחת בתוך הגשה: תאריך, סוג משמרת וזמין/מועדף/לא זמין.
model ShiftAvailability {
  preference   AvailabilityPreference @default(AVAILABLE)
  id           String                 @id @default(cuid())
  submissionId String
  date         DateTime               @db.Date
  shiftType    ShiftType

  submission AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submissionId, date, shiftType])
  @@index([date, shiftType])
}

// ─── Roster ──────────────────────────────────────────────────────────────────

/// תאריכי העבודה וחלון ההגשות במתקן. משותף להגשות העובדים ולסידור העבודה.
model SchedulePeriod {
  submissionState         SubmissionState @default(SCHEDULED)
  id                      String          @id @default(cuid())
  facilityId              String
  name                    String
  submissionOpensAt       DateTime        @default(now())
  submissionDeadline      DateTime
  submissionNotifiedAt    DateTime?
  submissionWindowManaged Boolean         @default(false)
  startDate               DateTime        @db.Date
  endDate                 DateTime        @db.Date

  facility                Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  schedule                Roster?
  availabilitySubmissions AvailabilitySubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, facilityId])
  @@index([facilityId])
  @@index([facilityId, endDate])
  @@index([facilityId, startDate, endDate])
  @@index([startDate, endDate])
}

/// סידור העבודה של תקופה אחת. מרכז גרסאות; הפרסום נשמר בגרסה בלבד.
model Roster {
  id         String @id @default(cuid())
  facilityId String
  periodId   String @unique

  generatedAt DateTime @default(now())

  archivedAt  DateTime?
  createdById String

  facility  Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  period    SchedulePeriod @relation(fields: [periodId, facilityId], references: [id, facilityId], onDelete: Cascade)
  createdBy User           @relation("ScheduleCreatedBy", fields: [createdById], references: [id])

  versions      RosterVersion[]
  assignments   ShiftAssignment[]
  warnings      ScheduleWarning[]
  changeLogs    ScheduleChangeLog[]
  employeeStats EmployeeScheduleStats[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, facilityId])
  @@unique([periodId, facilityId])
  @@index([facilityId])
  @@index([facilityId, archivedAt])
  @@index([createdById])
}

/// גרסת טיוטה או פרסום. version הוא מספר הגרסה; revision מונע דריסת עריכות.
model RosterVersion {
  revision      Int                     @default(0)
  warnings      ScheduleWarning[]
  employeeStats EmployeeScheduleStats[]
  id            String                  @id @default(cuid())
  scheduleId    String
  facilityId    String
  version       Int
  status        ScheduleVersionStatus   @default(DRAFT)
  isActive      Boolean                 @default(false)
  publishedAt   DateTime?
  createdById   String
  note          String?

  schedule Roster @relation(fields: [scheduleId, facilityId], references: [id, facilityId], onDelete: Cascade)
  facility Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  createdBy User @relation("ScheduleVersionCreatedBy", fields: [createdById], references: [id])

  assignments ShiftAssignment[]
  changeLogs  ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, scheduleId, facilityId])
  @@unique([scheduleId, version])
  @@index([scheduleId])
  @@index([facilityId])
  @@index([status])
  @@index([isActive])
  @@index([scheduleId, status, isActive, version])
}

// ─── Roster assignments ─────────────────────────────────────────────────────

/// איוש: עובד בתאריך, במשמרת ובתפקיד בתוך גרסת סידור מסוימת.
model ShiftAssignment {
  source      AssignmentSource @default(MANUAL)
  isLocked    Boolean          @default(false)
  id          String           @id @default(cuid())
  scheduleId  String
  versionId   String
  employeeId  String
  facilityId  String
  shiftRoleId String
  date        DateTime         @db.Date
  shiftType   ShiftType

  schedule Roster @relation(fields: [scheduleId, facilityId], references: [id, facilityId], onDelete: Cascade)

  version RosterVersion @relation(fields: [versionId, scheduleId, facilityId], references: [id, scheduleId, facilityId], onDelete: Restrict)

  employee Employee @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Cascade)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  shiftRole ShiftRole @relation(fields: [shiftRoleId, facilityId], references: [id, facilityId], onDelete: Cascade)

  changeLogs ScheduleChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([versionId, employeeId, date, shiftType])
  @@index([scheduleId])
  @@index([versionId])
  @@index([versionId, date])
  @@index([versionId, date, shiftType, shiftRoleId])
  @@index([scheduleId, date])
  @@index([scheduleId, facilityId])
  @@index([employeeId, facilityId])
  @@index([shiftRoleId, facilityId])
  @@index([employeeId, date])
  @@index([facilityId, date])
  @@index([shiftRoleId])
  @@index([shiftType])
}

/// אזהרה מחושבת ששייכת לגרסת סידור מסוימת.
model ScheduleWarning {
  versionId   String
  version     RosterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  id          String              @id @default(cuid())
  scheduleId  String
  type        WarningType
  severity    WarningSeverity
  employeeId  String?
  facilityId  String?
  shiftRoleId String?
  shiftType   ShiftType?
  date        DateTime?           @db.Date
  message     String

  schedule  Roster @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee  Employee?    @relation(fields: [employeeId], references: [id])
  facility  Facility?    @relation(fields: [facilityId], references: [id])
  shiftRole ShiftRole?   @relation(fields: [shiftRoleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([versionId])
  @@index([scheduleId, date])
  @@index([employeeId, date])
  @@index([facilityId, date])
  @@index([shiftRoleId, date])
  @@index([shiftType])
}

/// מדדי עומס מחושבים לעובד בגרסה אחת; אינם רישום נוכחות בפועל.
model EmployeeScheduleStats {
  versionId     String
  version       RosterVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  id            String              @id @default(cuid())
  employeeId    String
  scheduleId    String
  totalShifts   Int                 @default(0)
  morningShifts Int                 @default(0)
  eveningShifts Int                 @default(0)
  nightShifts   Int                 @default(0)
  weekendShifts Int                 @default(0)
  totalHours    Int                 @default(0)

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule Roster @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, versionId])
  @@index([versionId])
  @@index([scheduleId])
}

/// אירוע בהיסטוריית הסידור: מי שינה, הסיבה והנתונים לפני ואחרי.
model ScheduleChangeLog {
  id                String             @id @default(cuid())
  scheduleId        String
  versionId         String?
  shiftAssignmentId String?
  changedById       String
  changeType        ScheduleChangeType
  message           String?
  reason            String?
  beforeData        Json?
  afterData         Json?
  createdAt         DateTime           @default(now())

  schedule Roster @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  version RosterVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)

  changedBy User @relation("ScheduleChangedBy", fields: [changedById], references: [id])

  @@index([scheduleId, createdAt])
  @@index([versionId, createdAt])
  @@index([shiftAssignmentId])
  @@index([changedById, createdAt])
}
// ─── Holidays / Special Days ─────────────────────────────────────────────────

/// חג או יום מיוחד המשפיע על סיווג היום לצורך השיבוץ.
model Holiday {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  name      String
  kind      HolidayKind
  behavesAs DayCategory

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([behavesAs])
}
/// הגדרת מערכת אחת לפי מפתח.
model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
